                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/carrinho/{{usuarioId}}/itens/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carrinho",
                "{{usuarioId}}",
                "itens",
                "{{itemId}}"
              ]
            },
            "description": "AtualizarQuantidadeRequest { quantidade }."
          },
          "response": []
        },
        {
          "name": "Remover Item do Carrinho",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carrinho/{{usuarioId}}/itens/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carrinho",
                "{{usuarioId}}",
                "itens",
                "{{itemId}}"
              ]
            },
            "description": "HTTP 204 No Content."
          },
          "response": []
        },
        {
          "name": "Esvaziar Carrinho",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carrinho/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carrinho",
                "{{usuarioId}}"
              ]
            },
            "description": "Remove todos os itens do carrinho do usuário. HTTP 204 No Content."
          },
          "response": []
        }
      ]
    },
